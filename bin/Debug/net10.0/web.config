<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Medicount.Chatbot.dll"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\startup\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Staging" />
          <environmentVariable name="ACCOUNT_HASH_SECRET" value="REPLACE_WITH_EXISTING_ACCOUNT_HASH_SECRET" />
          <environmentVariable name="ConnectionStrings__ChatDb" value="REPLACE_WITH_APPROVED_CHATDB_CONNECTION_STRING" />
          <environmentVariable name="DIAGNOSTICS_ENABLED" value="true" />
          <environmentVariable name="DIAGNOSTICS_LOG_DIRECTORY" value=".\logs\application" />
          <environmentVariable name="DIAGNOSTICS_MAX_FILE_BYTES" value="10485760" />
          <environmentVariable name="DIAGNOSTICS_MAX_FILES" value="14" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
